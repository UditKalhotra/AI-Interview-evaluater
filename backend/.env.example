# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Local MongoDB instance (mongod running on your machine, no Docker)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=voice_interview_db

# Used starting Module 6 (Gemini behavior scoring) — not needed for Module 1
GEMINI_API_KEY=

# Used starting Module 3 (TTS) — not needed for Module 1
TTS_API_KEY=
