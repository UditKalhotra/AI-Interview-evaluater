# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Local MongoDB instance (mongod running on your machine, no Docker)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=voice_interview_db

# Used starting Module 6 (Gemini behavior scoring) — not needed for Module 1
GEMINI_API_KEY=

# Used starting Module 3 (TTS).
# Leave TTS_API_KEY empty to use the free gTTS fallback (no key, no signup —
# good for local dev/testing). Set it to an OpenAI API key to use OpenAI's
# TTS API instead (higher quality, this is the "real" provider for the demo).
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
